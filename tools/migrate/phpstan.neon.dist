# The shared settings (level, stubs) live in tools/php/phpstan.neon; this
# project reads the stubs from its own vendor/ (%rootDir% is this project's
# vendor/phpstan/phpstan).
includes:
	- ../php/phpstan.neon

parameters:
	paths:
		- 18-wordpress.php
		- tests/php
	excludePaths:
		# The doubles exist only at the tests' runtime, and the bootstrap
		# defines ABSTRACT the way WordPress would: PHPStan knows these names
		# from the WordPress stubs, and a second declaration is a clash.
		- tests/php/Doubles
		- tests/php/bootstrap.php
	scanFiles:
		# WooCommerce supplies wc_get_product and its Product at runtime; ACF
		# free supplies its field functions: neither is in the WordPress
		# stubs nor on Packagist. Only the surface this driver touches is
		# declared; the runtime doubles live in tests/php/Doubles and
		# tests/php/Support, which stay out of analysis so real WordPress
		# names are not shadowed.
		- tests/php/Doubles/woocommerce-stubs.php
		- tests/php/Doubles/acf-stubs.php
