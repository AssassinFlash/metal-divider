{
	"name": "metal-divider/md-site",
	"description": "The presentation layer of metal-divider.com: the LiveCanvas templates, the WindPress volume, present, and the pattern data shortcodes.",
	"type": "wordpress-plugin",
	"license": "proprietary",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"10up/wp_mock": "^1.1",
		"php-stubs/wordpress-stubs": "~7.1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"woocommerce/woocommerce-sniffs": "^2.0",
		"wp-coding-standards/wpcs": "^3.4"
	},
	"autoload": {
		"psr-4": {
			"MetalDivider\\Site\\": "includes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"MetalDivider\\Site\\Tests\\": "tests/php/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.3"
		},
		"sort-packages": true
	}
}
