# The shared settings (level, stubs) live in tools/php/phpstan.neon; this
# project reads the stubs from its own vendor/ (%rootDir% is this project's
# vendor/phpstan/phpstan).
includes:
	- ../../tools/php/phpstan.neon

parameters:
	paths:
		- md-inquiry.php
		- includes
		- tests/php
	scanFiles:
		# WP_Mock declares its hook responders next to the hooks, outside the
		# autoloader.
		- vendor/10up/wp_mock/php/WP_Mock/Action.php
		- vendor/10up/wp_mock/php/WP_Mock/Filter.php
		- vendor/10up/wp_mock/php/WP_Mock/HookedCallback.php
