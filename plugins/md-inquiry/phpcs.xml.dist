<?xml version="1.0"?>
<ruleset name="MD Inquiry">
	<description>md-inquiry: the shared plugin rules (tools/php/phpcs.xml) with this plugin's text domain and prefixes.</description>

	<file>md-inquiry.php</file>
	<file>includes</file>
	<file>tests</file>
	<file>../../tools/php/bootstrap.php</file>

	<rule ref="../../tools/php/phpcs.xml"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="md-inquiry"/>
			</property>
		</properties>
	</rule>

	<!-- The unit tests run without WordPress (WP_Mock): WordPress's runtime alternatives, its globals and output escaping do not apply there. -->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.GlobalVariablesOverride">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="MetalDivider\Inquiry"/>
				<element value="md_inquiry"/>
			</property>
		</properties>
	</rule>
</ruleset>
