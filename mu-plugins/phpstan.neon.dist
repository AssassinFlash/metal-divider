# The shared settings (level, stubs) live in tools/php/phpstan.neon.
includes:
	- ../tools/php/phpstan.neon

parameters:
	paths:
		# Every mu-plugin is listed by name. A new file that is not added here
		# is invisible to the analysis, and its tests then fail with
		# `function.notFound` for every symbol they exercise — the chat
		# plugins shipped that way and turned the gate red with 75 errors that
		# were all pointing at the missing entries below.
		- md-chat-delete.php
		- md-chat-email.php
		- md-chat-launcher.php
		- md-deploy-reset.php
		- md-error-recorder.php
		- md-site-guards.php
		- md-staging-guards.php
		- md-wecom-notify.php
		- md-kb-endpoint.php
		- md-chat-email.php
		- md-chat-delete.php
		- md-chat-launcher.php
		- tests/php
	excludePaths:
		# The bootstrap defines WordPress's own hook functions for the tests;
		# PHPStan already knows them from the WordPress stubs, and a second
		# declaration is a clash.
		- tests/php/bootstrap.php
		# The analysis-only stubs of third-party runtime surfaces.
		- tests/php/Doubles
	scanFiles:
		# Rapls (rapls-ai-chatbot) supplies RAPLSAICH_Search_Engine at
		# runtime; it is neither in the WordPress stubs nor on Packagist.
		# Only the surface the endpoint touches is declared.
		- tests/php/Doubles/rapls-stubs.php
		# ACF and the product helpers the endpoint reads at answer time.
		- tests/php/Doubles/product-stubs.php
		# WP-CLI ships no stubs and is not in the WordPress stubs; the kb
		# read-back command registers itself on it. Only the surface the
		# mu-plugins touch is declared.
		- tests/php/Doubles/wp-cli-stubs.php
