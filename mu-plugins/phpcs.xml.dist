<?xml version="1.0"?>
<ruleset name="MD mu-plugins">
	<description>The production must-use plugins: the shared plugin rules (tools/php/phpcs.xml) with this project's prefixes.</description>

	<file>md-deploy-reset.php</file>
	<file>md-error-recorder.php</file>
	<file>md-site-guards.php</file>
	<file>md-staging-guards.php</file>
	<file>md-wecom-notify.php</file>
	<file>md-kb-endpoint.php</file>
	<file>md-chat-email.php</file>
	<file>tests</file>
	<exclude-pattern>tests/php/bootstrap.php</exclude-pattern>
	<exclude-pattern>tests/php/Doubles/*</exclude-pattern>

	<rule ref="../tools/php/phpcs.xml"/>

	<!--
		The deployment name of a must-use plugin is the plugin: one file named
		after its purpose, not after the class in it.
	-->
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>md-deploy-reset.php</exclude-pattern>
		<exclude-pattern>md-error-recorder.php</exclude-pattern>
		<exclude-pattern>md-staging-guards.php</exclude-pattern>
		<exclude-pattern>md-wecom-notify.php</exclude-pattern>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="Md\Mu"/>
				<element value="md_mu"/>
				<element value="md_site_guards"/>
				<element value="md_wecom_notify"/>
				<element value="md_kb_endpoint"/>
				<element value="md_chat_email"/>
			</property>
		</properties>
	</rule>
</ruleset>
